# PostgreSQL — Neon ou Supabase (chaîne de connexion complète).
# Neon     : https://console.neon.tech → Connection string
# Supabase : Project Settings → Database → Connection string (URI, pooler)
# Sans cette variable, le site fonctionne avec les données de src/content/bac.ts.
# Garder `channel_binding` hors de l'URL : le pilote HTTP de Neon le renvoie
# dans le corps de la requête, que l'API rejette.
DATABASE_URL=

# Assistant IA. Fournisseur : gemini | claude | faq. Vide = automatique
# (Gemini si GEMINI_API_KEY est renseignée, sinon Claude, sinon FAQ sans IA).
# Si l'IA échoue (quota gratuit épuisé, crédit à zéro, panne), l'assistant
# répond à partir des fiches du site au lieu d'afficher une erreur.
ASSISTANT_PROVIDER=

# Google Gemini (offre gratuite, avec quotas) — https://aistudio.google.com/apikey
# Attention : sur l'offre gratuite, Google peut utiliser les échanges pour
# améliorer ses modèles.
GEMINI_API_KEY=
# Modèle Gemini (par défaut : gemini-flash-latest)
GEMINI_MODEL=

# Claude (API Anthropic, payante : crédit prépayé) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modèle utilisé par l'assistant (par défaut : claude-opus-5)
ANTHROPIC_MODEL=claude-opus-5
# Requis si la clé n'est pas déjà rattachée à un espace de travail : l'API
# refuse alors l'appel avec « This API key is not scoped to a workspace ».
# ID affiché dans Console → Settings → Workspaces. Laisser vide si la clé est
# déjà scopée à un workspace.
ANTHROPIC_WORKSPACE_ID=

# Secret de l'application (32 caractères minimum) : signe les QR des convocations
# et chiffre les mots de passe temporaires. Obligatoire en production.
# Le changer invalide les QR déjà imprimés. Générer : openssl rand -base64 48
APP_SECRET=

# Adresse publique du site (imprimée sur les convocations)
SITE_URL=http://localhost:3000

# Mot de passe des comptes du personnel créés par pnpm db:seed:demo
DEMO_PASSWORD=Mianara2027!
