# PostgreSQL — Neon ou Supabase (chaîne de connexion complète).
# Neon     : https://console.neon.tech → Connection string
# Supabase : Project Settings → Database → Connection string (URI, pooler)
# Sans cette variable, le site fonctionne avec les données de src/content/bac.ts.
DATABASE_URL=

# Assistant IA (API Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modèle utilisé par l'assistant (par défaut : claude-opus-5)
ANTHROPIC_MODEL=claude-opus-5

# Secret de l'application (32 caractères minimum) : signe les QR des convocations
# et chiffre les mots de passe temporaires. Obligatoire en production.
# Le changer invalide les QR déjà imprimés. Générer : openssl rand -base64 48
APP_SECRET=

# Adresse publique du site (imprimée sur les convocations)
SITE_URL=http://localhost:3000

# Mot de passe des comptes du personnel créés par pnpm db:seed:demo
DEMO_PASSWORD=Mianara2027!
